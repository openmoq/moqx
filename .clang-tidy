---
# Denylist starts from '*', then drops:
#  - vendor/platform families for stacks moqx doesn't touch (LLVM's own codebase, its libc, ...)
#  - individual checks that fight this codebase's style
Checks: >
  *,
  -llvm-*,
  -llvmlibc-*,
  -altera-*,
  -fuchsia-*,
  -zircon-*,
  -android-*,
  -objc-*,
  -openmp-*,
  -mpi-*,
  -darwin-*,
  -abseil-*,
  -linuxkernel-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-owning-memory,
  -google-readability-todo,
  -google-readability-namespace-comments,
  -modernize-use-trailing-return-type,
  -misc-non-private-member-variables-in-classes

# The subset actually gated; everything else above still reports but doesn't
# fail the build.
WarningsAsErrors: >
  bugprone-*,
  performance-*,
  clang-analyzer-*,
  concurrency-*,
  cert-*
HeaderFilterRegex: 'src/.*|test/.*|benchmark/.*'
FormatStyle: file
...
